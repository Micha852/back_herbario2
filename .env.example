# =============================================================================
# Herbario HUAZ - Backend
# Copia este archivo como .env y completa los valores.
# Las variables marcadas [obligatoria] se validan al arrancar (src/config/env.validation.ts).
# =============================================================================

# --- Aplicación --------------------------------------------------------------
NODE_ENV="development"          # development | production
PORT=4000                        # el front usa NEXT_PUBLIC_API_URL=http://localhost:4000
CORS_ORIGIN="http://localhost:3000"   # URL del front
APP_URL="http://localhost:3000"       # URL pública del front (enlaces en correos)

# --- Base de datos [obligatoria] ---------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hdua_db?schema=public"

# --- JWT [obligatorias] ------------------------------------------------------
# Deben ser distintos. Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# En producción: mínimo 32 caracteres y nada de valores de ejemplo (la app no arranca).
JWT_SECRET="cambia-esto-por-un-secreto-aleatorio"
JWT_EXPIRES_IN="7d"              # duración del access token (ej. 15m, 1h, 7d)
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-aleatorio"
JWT_REFRESH_EXPIRATION="30d"     # duración del refresh token

# --- Correo (SMTP) -----------------------------------------------------------
# Opcional en desarrollo: sin estas variables los correos se muestran en la consola
# del back en vez de enviarse. Obligatorias en producción (recuperar contraseña).
# MAIL_HOST="smtp.gmail.com"
# MAIL_PORT=587                  # 465 = SSL
# MAIL_USER="tu-correo@gmail.com"
# MAIL_PASSWORD="contraseña-de-aplicación"
# MAIL_FROM="Herbario HUAZ <noreply@uniamazonia.edu.co>"

# Destinatario del buzón de sugerencias
HERBARIO_EMAIL="herbario@uniamazonia.edu.co"

# --- Ingreso con Chairá (opcional) --------------------------------------------
# Plataforma de la Universidad de la Amazonia. Sin CHAIRA_CLIENT_ID el botón no aparece.
# Solo confirma que la persona inició sesión allá: crea cuentas "Visitante Chairá N" (rol VISITANTE).
# CHAIRA_CLIENT_ID=""
# CHAIRA_REDIRECT_URI="http://localhost:4000/api/v1/auth/chaira/callback"   # este back + /api/v1/auth/chaira/callback
# CHAIRA_AUTH_URL="https://chaira.uniamazonia.edu.co/ChairaApi/oauth2/auth"
