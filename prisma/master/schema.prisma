// Base "master" de la plataforma: qué herbarios existen y dónde están sus datos.
// Cada herbario tiene su PROPIA base (dbName) con el esquema de ../schema.prisma.
//
//   Migraciones:  npm run master:migrate        (prisma migrate deploy de este esquema)
//   Cliente:      import { PrismaClient } from '.prisma/master-client'

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/master-client"
}

datasource db {
  provider = "postgresql"
  url      = env("MASTER_DATABASE_URL")
}

/// Un herbario de la plataforma (tenant). Se entra por <slug>.<PLATFORM_DOMAIN>.
model Herbarium {
  id           String          @id @default(uuid())
  /// Subdominio: minúsculas, números y guiones (huaz, coah, jardin-botanico)
  slug         String          @unique @db.VarChar(40)
  name         String          @db.VarChar(150)
  /// Base de datos del herbario (mismo servidor que DATABASE_URL)
  dbName       String          @unique @db.VarChar(63)
  status       HerbariumStatus @default(PROVISIONING)
  contactEmail String?         @db.VarChar(100)
  suspendedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@map("herbaria")
}

enum HerbariumStatus {
  /// Creándose (base, migraciones, datos iniciales)
  PROVISIONING
  ACTIVE
  /// Sin acceso (p. ej. falta de pago); sus datos se conservan
  SUSPENDED
  /// La creación falló: revisar y reintentar
  FAILED
}

/// Administrador de la PLATAFORMA (crea y suspende herbarios). No es usuario de ningún herbario.
model PlatformAdmin {
  id        String    @id @default(uuid())
  email     String    @unique @db.VarChar(100)
  name      String    @db.VarChar(100)
  password  String    @db.VarChar(255)
  isActive  Boolean   @default(true)
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("platform_admins")
}
