# Variables del back dentro de Docker (docker-compose.yml las lee de .env.docker).
# DATABASE_URL y PORT las pone el compose.
NODE_ENV=production

# --- Multitenant ---
# Dominio de la plataforma: cada herbario entra por <slug>.PLATFORM_DOMAIN (DNS comodín *.dominio)
PLATFORM_DOMAIN=
# Solo con un único herbario y sin subdominios: el slug que atiende por defecto
# DEFAULT_HERBARIUM=
# Clientes de Prisma abiertos a la vez (uno por herbario) y conexiones de cada uno
# TENANT_POOL_SIZE=50
# TENANT_CONNECTION_LIMIT=5
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
# Detrás de nginx (u otro proxy): 1 = tomar la IP real del cliente (límite de intentos por persona).
# Solo si el back NO es accesible directamente (publicado en 127.0.0.1).
TRUST_PROXY=0

# Obligatorias en producción: ≥32 caracteres, distintas y aleatorias:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRATION=30d

# Correo (obligatorio en producción para recuperar contraseña y credenciales)
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=Herbario HUAZ <noreply@uniamazonia.edu.co>
HERBARIO_EMAIL=herbario@uniamazonia.edu.co
